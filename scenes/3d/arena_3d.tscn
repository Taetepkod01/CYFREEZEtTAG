offset_right = -24.0
offset_bottom = -68.0
grow_horizontal = 2
grow_vertical = 2
bbcode_enabled = true
text = "[color=#00e5ff][b]OBJECTIVE & RULES:[/b][/color]
- [color=#ff5252]TAGGERS[/color] must tag all runners to freeze them in ice cubes!
- [color=#69f0ae]RUNNERS[/color] must survive until time runs out, or touch frozen teammates to thaw them!

[color=#ffe066][b]ITEMS & POWER-UPS ([E] to use):[/b][/color]
- [b]Speed Boost:[/b] Move 1.3x faster for 6s
- [b]Ice Shield:[/b] Blocks 1 freeze attempt
- [b]Heater:[/b] Unfreezes yourself immediately
- [b]Banana Trap:[/b] Drops behind you; slips enemies for 2.5s
- [b]Dash Tackle:[/b] 2s immunity, deals 20 HP to tagger
- [b]Vortex:[/b] Gravitational pull field

[color=#a78bfa][b]3D CONTROLS:[/b][/color]
- [b]Mouse:[/b] Orbit Camera | [b]WASD:[/b] Move | [b]Space:[/b] Jump | [b]E:[/b] Use Item"

